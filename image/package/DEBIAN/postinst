#!/bin/sh
set -eu

install -d -m 0750 /etc/msfixit-shopos
install -d -m 0755 /var/lib/msfixit-shopos
install -d -m 0700 /var/lib/msfixit-shopos/update
install -d -m 0755 /run/msfixit-shopos
install -d -m 0755 /srv/www
install -d -m 0755 /etc/nftables.d
install -d -m 0755 /etc/plymouth
chmod 0755 /usr/local/sbin/msfixit-update /usr/local/sbin/msfixit-update-agent /usr/local/sbin/msfixit-update-center /usr/local/sbin/msfixit-slot-writer /usr/local/sbin/msfixit-update-boot-sync /usr/local/sbin/msfixit-boot-selector /usr/local/sbin/msfixit-kiosk-session /usr/local/sbin/msfixit-display-keepawake /usr/local/sbin/msfixit-first-login-init /usr/local/sbin/msfixit-wifi-connect /usr/local/sbin/msfixit-time-bootstrap /usr/local/sbin/msfixit-apply-resource-budget /usr/local/sbin/msfixit-finalize-resource-budget /usr/local/sbin/msfixit-hardware-manager /usr/local/sbin/msfixit-hardware-action /usr/local/sbin/msfixit-cloudflared-run
chmod 0640 /etc/msfixit-shopos/update-slots.json /etc/msfixit-shopos/update-source.json
chmod 0440 /etc/sudoers.d/msfixit-shopos-update-center /etc/sudoers.d/msfixit-shopos-hardware-manager

if ! getent passwd shopos-kiosk >/dev/null 2>&1; then
    useradd --system --home-dir /var/lib/msfixit-shopos/kiosk --create-home --shell /usr/sbin/nologin shopos-kiosk
fi
for group in video render input; do
    getent group "$group" >/dev/null 2>&1 && usermod -a -G "$group" shopos-kiosk || true
done
install -d -o shopos-kiosk -g shopos-kiosk -m 0700 /var/lib/msfixit-shopos/kiosk

if ! getent group shopos-hwmon >/dev/null 2>&1; then groupadd --system shopos-hwmon; fi
if ! getent group shopos-hwapi >/dev/null 2>&1; then groupadd --system shopos-hwapi; fi
if ! getent passwd shopos-hwmon >/dev/null 2>&1; then
    useradd --system --gid shopos-hwmon --home-dir /var/lib/msfixit-shopos/hardware-manager --no-create-home --shell /usr/sbin/nologin shopos-hwmon
fi
usermod -a -G shopos-hwapi shopos-hwmon
usermod -a -G shopos-hwapi www-data
install -d -o shopos-hwmon -g shopos-hwmon -m 0750 /var/lib/msfixit-shopos/hardware-manager

/usr/local/sbin/msfixit-apply-resource-budget

if ! grep -Fq 'include "/etc/nftables.d/*.nft"' /etc/nftables.conf; then
    printf '\ninclude "/etc/nftables.d/*.nft"\n' >> /etc/nftables.conf
fi

brand_source=/usr/share/msfixit-shopos/branding/msfixit-brand-full.webp
plymouth_logo=/usr/share/plymouth/themes/msfixit-shopos/logo.png
if [ -r "$brand_source" ]; then
    php -r '
        $image = new Imagick($argv[1]);
        $image->setIteratorIndex(0);
        $image->setImageFormat("png");
        $image->thumbnailImage(520, 300, true, true);
        $image->stripImage();
        if (!$image->writeImage($argv[2])) { exit(1); }
    ' "$brand_source" "$plymouth_logo"
    chmod 0644 "$plymouth_logo"
fi

cat > /etc/plymouth/plymouthd.conf <<'EOF_PLYMOUTH'
[Daemon]
Theme=msfixit-shopos
ShowDelay=0
DeviceTimeout=8
EOF_PLYMOUTH

for cmdline in /boot/firmware/cmdline.txt /boot/cmdline.txt; do
    [ -f "$cmdline" ] || continue
    current="$(cat "$cmdline")"
    current="$(printf '%s\n' "$current" | sed -E 's/(^|[[:space:]])consoleblank=[^[:space:]]+//g; s/[[:space:]]+/ /g; s/^ //; s/ $//')"
    for parameter in quiet splash loglevel=3 systemd.show_status=auto rd.udev.log_level=3 vt.global_cursor_default=0 logo.nologo consoleblank=0; do
        case " $current " in *" $parameter "*) ;; *) current="$current $parameter" ;; esac
    done
    printf '%s\n' "$current" > "$cmdline"
done

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme -R msfixit-shopos
elif command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u
fi

systemctl disable nginx.service 2>/dev/null || true
systemctl disable mariadb.service 2>/dev/null || true
systemctl disable redis-server.service 2>/dev/null || true
for unit in /lib/systemd/system/php*-fpm.service; do
    [ -e "$unit" ] || continue
    systemctl disable "$(basename "$unit")" 2>/dev/null || true
done

# ShopOS uses NetworkManager for Ethernet and Wi-Fi. Do not leave the base
# image's systemd-networkd stack enabled in parallel: on Raspberry Pi it can
# fail independently, mark the boot degraded and introduce wait-online races.
systemctl disable systemd-networkd.service 2>/dev/null || true
systemctl disable systemd-networkd.socket 2>/dev/null || true
systemctl disable systemd-networkd-wait-online.service 2>/dev/null || true
systemctl enable NetworkManager.service 2>/dev/null || true
systemctl enable systemd-timesyncd.service 2>/dev/null || true
systemctl enable nftables.service 2>/dev/null || true
systemctl enable msfixit-time-bootstrap.service 2>/dev/null || true
systemctl enable msfixit-update-boot-sync.service 2>/dev/null || true
systemctl enable msfixit-update-agent.timer 2>/dev/null || true
systemctl enable msfixit-firstboot.service 2>/dev/null || true
systemctl enable msfixit-brand-shop.service 2>/dev/null || true
systemctl enable msfixit-admin-console-init.service 2>/dev/null || true
systemctl enable msfixit-display-keepawake.service 2>/dev/null || true
systemctl enable msfixit-first-login.service 2>/dev/null || true
systemctl enable msfixit-boot-console.service 2>/dev/null || true
systemctl enable msfixit-kiosk.service 2>/dev/null || true
systemctl enable msfixit-resource-budget.service 2>/dev/null || true
systemctl enable msfixit-hardware-manager.service 2>/dev/null || true
systemctl set-default graphical.target 2>/dev/null || true

exit 0
