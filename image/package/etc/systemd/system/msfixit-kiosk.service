[Unit]
Description=Ms. FixIT ShopOS local graphical interface
After=local-fs.target nginx.service msfixit-brand-shop.service msfixit-first-login.service
Wants=nginx.service msfixit-brand-shop.service msfixit-first-login.service
ConditionPathExists=/usr/bin/chromium

[Service]
Type=simple
User=shopos-kiosk
Group=shopos-kiosk
SupplementaryGroups=video render input
Environment=HOME=/var/lib/msfixit-shopos/kiosk
Environment=XDG_RUNTIME_DIR=/run/msfixit-shopos-kiosk
RuntimeDirectory=msfixit-shopos-kiosk
RuntimeDirectoryMode=0700
TTYPath=/dev/tty7
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
PAMName=login
ExecStart=/usr/bin/xinit /usr/local/sbin/msfixit-kiosk-session -- :0 vt7 -keeptty -nolisten tcp
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
CPUWeight=20
CPUQuota=150%
MemoryHigh=640M
MemoryMax=896M
TasksMax=160
OOMPolicy=stop
Nice=5

[Install]
WantedBy=graphical.target
