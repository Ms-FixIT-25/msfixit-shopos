[Unit]
Description=Ms. FixIT ShopOS persistent X display session
Requires=msfixit-brand-shop.service msfixit-admin-console-init.service
After=local-fs.target systemd-logind.service msfixit-brand-shop.service msfixit-admin-console-init.service
Wants=nginx.service NetworkManager.service
ConditionPathExists=/usr/bin/chromium
ConditionPathExists=/usr/bin/xinit
ConditionPathExists=/usr/local/sbin/msfixit-setup-gui

[Service]
Type=simple
User=root
Group=root
Environment=HOME=/root
Environment=DISPLAY=:0
ExecStartPre=/usr/bin/test -x /usr/bin/chromium
ExecStartPre=/usr/bin/test -x /usr/bin/xinit
ExecStartPre=/usr/bin/test -x /usr/local/sbin/msfixit-setup-gui
ExecStartPre=-/usr/bin/plymouth quit --retain-splash
ExecStart=/usr/bin/xinit /usr/local/sbin/msfixit-x-session -- :0 vt7 -keeptty -nolisten tcp
Restart=on-failure
RestartSec=5
TimeoutStartSec=4min
TimeoutStopSec=15
CPUWeight=20
CPUQuota=150%
MemoryHigh=640M
MemoryMax=896M
TasksMax=180
OOMPolicy=stop
Nice=5

[Install]
WantedBy=graphical.target
