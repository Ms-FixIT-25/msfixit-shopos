[Unit]
Description=Ms. FixIT ShopOS first-boot provisioning
Wants=msfixit-install-update-prefetch.service
After=local-fs.target msfixit-install-update-prefetch.service
ConditionPathExists=!/data/.shopos-initialized

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/msfixit-firstboot-progress
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
