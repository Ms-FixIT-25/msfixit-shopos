[Unit]
Description=Apply adaptive ShopOS Raspberry Pi performance profile
After=local-fs.target
Before=msfixit-resource-budget.service msfixit-kiosk.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/msfixit-apply-performance-profile
Nice=10
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10

[Install]
WantedBy=multi-user.target
