[Unit]
Description=Ms. FixIT branded WooCommerce setup
Wants=network-online.target
After=network-online.target msfixit-firstboot.service
ConditionPathExists=/data/.shopos-initialized
ConditionPathExists=!/data/.shopos-branded

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/msfixit-brand-shop
ExecStartPost=/usr/bin/touch /data/.shopos-branded
ExecStartPost=/usr/local/sbin/msfixit-boot-state ready 100 "ShopOS ist bereit" "Webshop, Serviceportal und Verwaltungsfunktionen wurden gestartet."
ExecStartPost=/usr/bin/touch /data/.shopos-ready
Restart=on-failure
RestartSec=30s
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
