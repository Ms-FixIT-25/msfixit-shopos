[Unit]
Description=Ms. FixIT ShopOS branded first-boot console
Wants=msfixit-firstboot.service msfixit-brand-shop.service
After=local-fs.target systemd-vconsole-setup.service
Before=getty@tty1.service msfixit-first-login.service
ConditionPathExists=!/data/.shopos-ready

[Service]
Type=oneshot
ExecStartPre=/bin/bash /usr/local/sbin/msfixit-display-keepawake /dev/tty1
ExecStart=/usr/local/sbin/msfixit-boot-console
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=no
TTYVHangup=no
TTYVTDisallocate=no
TimeoutStartSec=35min

[Install]
WantedBy=multi-user.target
