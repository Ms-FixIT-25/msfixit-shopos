[Unit]
Description=Ms. FixIT ShopOS Hardware Manager
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
StartLimitIntervalSec=120s
StartLimitBurst=5

[Service]
Type=simple
User=shopos-hwmon
Group=shopos-hwmon
SupplementaryGroups=shopos-hwapi
RuntimeDirectory=msfixit-hardware-manager
RuntimeDirectoryMode=0755
ExecStart=/usr/local/sbin/msfixit-hardware-manager
Restart=on-failure
RestartSec=10s
UMask=0027
Nice=10
CPUWeight=5
CPUQuota=20%
MemoryHigh=64M
MemoryMax=96M
TasksMax=48
IOSchedulingClass=idle
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/msfixit-shopos/hardware-manager /run/msfixit-hardware-manager

# Intentionally do not set NoNewPrivileges=yes or ProtectKernelTunables=yes here.
# The daemon itself remains an unprivileged shopos-hwmon process, but the one
# allowlisted sudo helper must be able to gain root and write the validated
# cpufreq scaling_governor sysfs node transactionally. The sudoers rule limits
# elevation to /usr/local/sbin/msfixit-hardware-action; arbitrary commands and
# arbitrary sysfs paths are rejected by that helper.

[Install]
WantedBy=multi-user.target
