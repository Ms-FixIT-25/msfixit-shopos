# ShopOS Raspberry Pi performance profile
# balanced: recommended default for a local shop appliance
# efficiency: lower idle power and background activity
# performance: more headroom for imports, updates and busy periods
SHOPOS_PERFORMANCE_PROFILE=balanced

# Leave automatic unless a hardware test proves another choice is better.
SHOPOS_CPU_GOVERNOR=auto

# Optional radio policy. auto keeps the interfaces available.
# Disable only after confirming Ethernet is the permanent connection.
SHOPOS_WIFI_POLICY=auto
SHOPOS_BLUETOOTH_POLICY=auto
