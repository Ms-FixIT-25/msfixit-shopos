[mysqld]
# Conservative defaults for a Raspberry Pi appliance. These values keep the
# database responsive without reserving workstation-sized caches at idle.
innodb_buffer_pool_size=192M
innodb_log_buffer_size=16M
max_connections=40
table_open_cache=400
table_definition_cache=400
thread_cache_size=8
performance_schema=OFF
skip_name_resolve=ON
