Window.SetBackgroundTopColor(0.035, 0.075, 0.145);
Window.SetBackgroundBottomColor(0.055, 0.155, 0.245);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);

name_image = Image.Text("MS. FIXIT", 0.14, 0.72, 0.74);
name_sprite = Sprite(name_image);

os_image = Image.Text("SHOPOS", 0.93, 0.25, 0.57);
os_sprite = Sprite(os_image);

slogan_image = Image.Text("IT geloest. Einfach. Fix. Guenstig.", 0.92, 0.94, 0.98);
slogan_sprite = Sprite(slogan_image);

message_image = Image.Text("System wird gestartet", 0.72, 0.80, 0.90);
message_sprite = Sprite(message_image);

fun place_elements() {
    center_x = Window.GetWidth() / 2;
    center_y = Window.GetHeight() / 2;

    logo_sprite.SetX(center_x - logo_image.GetWidth() / 2);
    logo_sprite.SetY(center_y - logo_image.GetHeight() / 2 - 80);

    name_sprite.SetX(center_x - name_image.GetWidth() / 2);
    name_sprite.SetY(center_y + 85);

    os_sprite.SetX(center_x - os_image.GetWidth() / 2);
    os_sprite.SetY(center_y + 120);

    slogan_sprite.SetX(center_x - slogan_image.GetWidth() / 2);
    slogan_sprite.SetY(center_y + 170);

    message_sprite.SetX(center_x - message_image.GetWidth() / 2);
    message_sprite.SetY(Window.GetHeight() - 75);
}

fun refresh_callback() {
    place_elements();
}

Plymouth.SetRefreshFunction(refresh_callback);
place_elements();
