# Ms. FixIT ShopOS discovery, SEO and Merchant feed settings
# Copy to /etc/msfixit-shopos/discovery.env and keep root:www-data 0640.

DISCOVERY_ENABLED=yes
DISCOVERY_LANDING_SLUG=kabel-zubehoer
DISCOVERY_PRODUCTS_PER_PAGE=12
DISCOVERY_MAX_SUGGESTIONS=8
DISCOVERY_REQUIRE_ORIGINAL_CONTENT=yes
DISCOVERY_MIN_SHORT_DESCRIPTION_CHARS=80
DISCOVERY_MIN_DESCRIPTION_CHARS=250

# Ownership verification does not set tracking cookies.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Product feed stays closed until Merchant Center, shipping and return settings
# have been deliberately configured and tested for Austria.
GOOGLE_MERCHANT_FEED_ENABLED=no
GOOGLE_MERCHANT_FEED_PATH=google-products.xml
GOOGLE_TARGET_COUNTRY=AT
GOOGLE_CONTENT_LANGUAGE=de
GOOGLE_SHIPPING_SERVICE=Standardversand Österreich
GOOGLE_SHIPPING_COST_EUR=
GOOGLE_DELIVERY_MIN_DAYS=
GOOGLE_DELIVERY_MAX_DAYS=
GOOGLE_RETURN_DAYS=14
GOOGLE_PRODUCT_CATEGORY=

# Structured shipping and return data stays disabled until the displayed shop
# conditions and the real fulfilment process match these values.
STRUCTURED_SHIPPING_APPROVED=no
STRUCTURED_RETURNS_APPROVED=no

# Analytics is deliberately not installed by this component. Search Console
# verification and the Merchant feed work without non-essential cookies.
