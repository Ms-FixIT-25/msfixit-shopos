# Ms. FixIT ShopOS – Austrian pop-up pilot and ALSO Austria connector
# Real credentials belong only in /etc/msfixit-shopos/also.env and the
# root-only files below /etc/msfixit-shopos/also/. Never commit them to Git.

AT_PILOT_ENABLED=yes
AT_PILOT_COUNTRY=AT
AT_PILOT_MAX_APPROVED_PRODUCTS=30
AT_PILOT_SINGLE_SUPPLIER=also-at
AT_PILOT_MANUAL_PRODUCT_APPROVAL=yes
AT_PILOT_MANUAL_ORDER_RELEASE=yes
AT_PILOT_AUTO_PUBLISH=no
AT_PILOT_AUTO_SUPPLIER_ORDER=no
AT_PILOT_PRICING_APPROVED=no
AT_PILOT_TARGET_GROSS_MARGIN_PERCENT=
AT_PILOT_PRICE_CHANGE_REVIEW_PERCENT=5
AT_PILOT_STOCK_SAFETY_QUANTITY=2
AT_PILOT_REQUIRE_POSITIVE_STOCK=yes

ALSO_ENABLED=no
ALSO_SUPPLIER_CODE=also-at
ALSO_SOURCE_MODE=sftp_csv
ALSO_IMPORT_SCHEDULE=every_6_hours
ALSO_AUTO_UPDATE_EXISTING_OFFERS=yes
ALSO_AUTO_CREATE_WOOCOMMERCE_DRAFT=no
ALSO_MAX_ROWS_PER_IMPORT=100000
ALSO_MAX_NEW_ITEMS_PER_IMPORT=5000
ALSO_REJECT_DUPLICATE_GTIN=no

# Licensed ALSO/1WorldSync content. This is a separate daily feed containing
# descriptions, sales arguments, specifications, image links, document links
# and (depending on package) accessory relations. Enable it only after the
# corresponding account contract and real feed format have been verified.
ALSO_CONTENT_ENABLED=no
ALSO_CONTENT_PACKAGE=none
ALSO_CONTENT_LANGUAGE=de-AT
ALSO_CONTENT_MEDIA_MODE=remote_only
ALSO_CONTENT_ALLOW_TEXT_IMPORT=yes
ALSO_ALLOW_REMOTE_IMAGES=yes
ALSO_ALLOW_REMOTE_DOCUMENTS=yes
ALSO_ALLOW_LOCAL_IMAGE_CACHE=no
ALSO_ALLOW_LOCAL_DOCUMENT_CACHE=no
ALSO_CONTENT_AUTO_APPLY_TO_DRAFTS=no
ALSO_CONTENT_MAX_ROWS_PER_IMPORT=100000
ALSO_CONTENT_LIST_SEPARATOR=|
ALSO_CONTENT_SFTP_REMOTE_FILE=

# Content feed parsing. Header names remain configurable because the actual
# ALSO/1WorldSync export is account- and package-specific. Multiple URLs and
# accessory SKUs may be separated by ALSO_CONTENT_LIST_SEPARATOR or supplied
# as JSON arrays. Specifications may be a JSON object.
ALSO_CONTENT_FEED_ENCODING=UTF-8
ALSO_CONTENT_FEED_DELIMITER=auto
ALSO_CONTENT_FIELD_SUPPLIER_SKU=SupplierSKU
ALSO_CONTENT_FIELD_STANDARD_DESCRIPTION=StandardDescription
ALSO_CONTENT_FIELD_MARKETING_DESCRIPTION=MarketingDescription
ALSO_CONTENT_FIELD_SELLING_POINTS=SellingPoints
ALSO_CONTENT_FIELD_FEATURES=Features
ALSO_CONTENT_FIELD_SPECIFICATIONS=Specifications
ALSO_CONTENT_FIELD_IMAGE_URLS=ImageURLs
ALSO_CONTENT_FIELD_DOCUMENT_URLS=DocumentURLs
ALSO_CONTENT_FIELD_DATASHEET_URL=DatasheetURL
ALSO_CONTENT_FIELD_ACCESSORY_SKUS=AccessorySKUs

# Official ALSO SFTP access must be enabled for the reseller account.
# Authentication by a dedicated SSH key is preferred. Password authentication
# uses the root-only file configured below; the password is never passed on the
# command line.
ALSO_SFTP_HOST=
ALSO_SFTP_PORT=22
ALSO_SFTP_USER=
ALSO_SFTP_REMOTE_FILE=
ALSO_SFTP_AUTH=key
ALSO_SFTP_IDENTITY_FILE=/etc/msfixit-shopos/also/id_ed25519
ALSO_SFTP_PASSWORD_FILE=/etc/msfixit-shopos/also/password
ALSO_SFTP_KNOWN_HOSTS=/etc/msfixit-shopos/also/known_hosts

# Commercial feed parsing. Header names are configurable because ALSO can
# provide individualized SFTP lists. Set the values exactly to the headers in
# the activated feed. Delimiter may be auto, semicolon, comma, tab or pipe.
ALSO_FEED_ENCODING=UTF-8
ALSO_FEED_DELIMITER=auto
ALSO_FIELD_SUPPLIER_SKU=SupplierSKU
ALSO_FIELD_MANUFACTURER=Manufacturer
ALSO_FIELD_MANUFACTURER_SKU=ManufacturerSKU
ALSO_FIELD_GTIN=EAN
ALSO_FIELD_PRODUCT_NAME=ProductName
ALSO_FIELD_SHORT_DESCRIPTION=ShortDescription
ALSO_FIELD_MARKETING_DESCRIPTION=MarketingDescription
ALSO_FIELD_CATEGORY=Category
ALSO_FIELD_PURCHASE_PRICE=PurchasePrice
ALSO_FIELD_CURRENCY=Currency
ALSO_FIELD_STOCK_QUANTITY=Stock
ALSO_FIELD_STOCK_STATUS=Availability
ALSO_FIELD_LEAD_TIME_DAYS=LeadTimeDays
ALSO_FIELD_IMAGE_URL=ImageURL
ALSO_FIELD_DATASHEET_URL=DatasheetURL

# XML Complete / WebServices are intentionally not guessed. Enable these only
# after ALSO supplies the account-specific XML guideline, endpoint, credentials
# and test environment. The first release uses SFTP for catalogue intake.
ALSO_XML_ENABLED=no
ALSO_XML_ENDPOINT=
ALSO_XML_CUSTOMER_NUMBER=
ALSO_XML_CREDENTIAL_FILE=/etc/msfixit-shopos/also/xml-credentials.env
ALSO_XML_PRICE_AVAILABILITY_ENABLED=no
ALSO_XML_ORDER_ENABLED=no
ALSO_XML_DROPSHIP_ENABLED=no
