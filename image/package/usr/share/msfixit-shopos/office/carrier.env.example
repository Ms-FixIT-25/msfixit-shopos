# Copy one file per carrier to /etc/msfixit-shopos/carriers/<carrier>.env
# and set mode 0600 root:root. Never commit production credentials.

CARRIER_ENABLED=no
CARRIER_CODE=
CARRIER_MODE=contract_api
CARRIER_ACCOUNT_NUMBER=
CARRIER_CUSTOMER_NUMBER=
CARRIER_DEPOT_NUMBER=
CARRIER_USERNAME=
CARRIER_PASSWORD=
CARRIER_CLIENT_ID=
CARRIER_CLIENT_SECRET=
CARRIER_API_BASE_URL=
CARRIER_LABEL_FORMAT=PDF_A6
CARRIER_PRINTER=
CARRIER_TEST_MODE=yes

# Contract-specific product and service identifiers supplied by the carrier.
CARRIER_DEFAULT_PRODUCT=
CARRIER_NOTIFICATION_SERVICE=
CARRIER_RETURN_PRODUCT=

# Some providers need separate billing or shipper identifiers.
CARRIER_BILLING_ACCOUNT=
CARRIER_SHIPPER_NUMBER=
CARRIER_EKP=
CARRIER_BILLING_NUMBER=
