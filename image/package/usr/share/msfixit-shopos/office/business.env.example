# Ms. FixIT Office, Fulfillment & DACH Compliance configuration
# Final invoice generation and checkout remain blocked while business, legal,
# tax and market approvals are incomplete.

BUSINESS_CONFIG_APPROVED=no
BUSINESS_NAME=Ms. FixIT
BUSINESS_LEGAL_NAME=
BUSINESS_OWNER_NAME=
BUSINESS_STREET=
BUSINESS_POSTCODE=
BUSINESS_CITY=
BUSINESS_COUNTRY=AT
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_WEBSITE=https://www.msfixit.at
BUSINESS_COMPANY_REGISTER=
BUSINESS_COURT=
BUSINESS_TAX_NUMBER=
BUSINESS_VAT_ID=
BUSINESS_EORI=
BUSINESS_IBAN=
BUSINESS_BIC=
BUSINESS_BANK_NAME=
SELLER_ESTABLISHMENT_COUNTRY=AT

# Tax profiles must be reviewed deliberately before final invoices or markets
# are approved. A German delivery does not by itself make the seller a German
# established business. Structured e-invoice decisions use the actual seller
# establishment and buyer type.
# Supported initial values:
#   review_required
#   at_small_business_exempt
#   at_standard_vat
#   eu_small_business_exempt
#   eu_oss
#   export_third_country
DEFAULT_TAX_MODE=review_required
TAX_MODE_AT=review_required
TAX_MODE_DE=review_required
TAX_MODE_CH=review_required
SMALL_BUSINESS_NOTICE=Umsatzsteuerbefreit aufgrund der Kleinunternehmerregelung gemäß § 6 Abs. 1 Z 27 UStG.
EU_SME_IDENTIFICATION_NUMBER=
OSS_REGISTRATION_NUMBER=
STRUCTURED_EINVOICE_ENABLED=no
STRUCTURED_EINVOICE_FORMAT=
B2G_EINVOICE_ENABLED=no
B2G_EINVOICE_FORMAT=

# Compliance is fail-closed. Markets, products, suppliers and legal documents
# must be approved in the compliance database. The Swiss market does not receive
# a fictional statutory withdrawal right; a voluntary policy must be approved.
COMPLIANCE_ENFORCEMENT=block
LEGAL_REVIEW_CONTACT=
TAX_REVIEW_CONTACT=
WITHDRAWAL_FUNCTION_ENABLED=yes
CH_VOLUNTARY_WITHDRAWAL_ENABLED=no
CH_VOLUNTARY_WITHDRAWAL_DAYS=
CH_INCOTERM_REVIEWED=no
CH_CUSTOMS_PRICING_REVIEWED=no

INVOICE_PREFIX=RE
CREDIT_NOTE_PREFIX=GU
DELIVERY_NOTE_PREFIX=LS
REMINDER_PREFIX=MA
SHIPMENT_PREFIX=VS
INVOICE_PAYMENT_DAYS=14
INVOICE_LANGUAGE=de_AT
INVOICE_CURRENCY=EUR
INVOICE_TRIGGER=payment
DELIVERY_NOTE_TRIGGER=processing

# Automation remains safe by default. Draft documents may be created;
# finalization, dispatch and printing require explicit approval.
AUTO_FINALIZE_INVOICES=no
AUTO_FINALIZE_DELIVERY_NOTES=no
AUTO_SEND_INVOICES=no
AUTO_SEND_REMINDERS=no
AUTO_PRINT_INVOICES=no
AUTO_PRINT_DELIVERY_NOTES=no
AUTO_PRINT_LABELS=no

# Formal reminder levels, fees and interest remain disabled until separately
# reviewed for customer type, contract and jurisdiction.
DUNNING_ENABLED=yes
DUNNING_AUTO_CREATE_FRIENDLY_REMINDER=yes
DUNNING_REQUIRE_APPROVAL_FROM_LEVEL=1

# SMTP settings are optional. Passwords belong only in this root-controlled file.
SMTP_ENABLED=no
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Ms. FixIT

# CUPS printer queues. Leave empty until printers are installed and tested.
PRINTER_A4=
PRINTER_LABEL=
LABEL_FORMAT=PDF_A6

# Carrier credentials belong in separate root-only files below
# /etc/msfixit-shopos/carriers/. Never commit real credentials.
DEFAULT_CARRIER=
DEFAULT_PACKAGE_WEIGHT_KG=
DEFAULT_PACKAGE_LENGTH_CM=
DEFAULT_PACKAGE_WIDTH_CM=
DEFAULT_PACKAGE_HEIGHT_CM=
DEFAULT_INCOTERM=
DEFAULT_ORIGIN_COUNTRY=AT

# ProSaldo currently has no direct shop API or invoice CSV import. ShopOS creates
# a controlled handoff ZIP with PDFs plus CSV manifests for manual review.
PROSALDO_EXPORT_ENABLED=yes
PROSALDO_EXPORT_PATH=/data/office/exports/prosaldo
PROSALDO_CONTACT_NUMBER_PREFIX=K
PROSALDO_PRODUCT_NUMBER_FIELD=MF_ARTICLE_NUMBER
