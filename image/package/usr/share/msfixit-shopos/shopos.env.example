# Copy this file to shopos.env on the boot partition before first boot.
# On Raspberry Pi OS style images this is usually /boot/firmware/shopos.env.

# Public shop address. Leave empty for local-LAN setup.
SHOP_URL=https://shop.msfixit.at
SHOP_TITLE=Ms. FixIT

# WordPress administrator. Leave the password empty to generate one.
SHOP_ADMIN_USER=shopadmin
SHOP_ADMIN_EMAIL=office@msfixit.at
SHOP_ADMIN_PASSWORD=

# Linux administration account. Leave empty to generate one.
OS_ADMIN_PASSWORD=

# Optional Cloudflare Tunnel token. The tunnel remains disabled when empty.
CF_TUNNEL_TOKEN=

# WordPress language and optional explicit core version.
WORDPRESS_LOCALE=de_DE
WORDPRESS_VERSION=latest
