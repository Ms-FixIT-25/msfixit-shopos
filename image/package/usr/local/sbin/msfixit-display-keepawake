#!/usr/bin/env bash
set -Eeuo pipefail

tty_path="${1:-/dev/tty1}"

# Headless builds and early boot can legitimately have no local VT yet.
[ -c "$tty_path" ] || exit 0

# Disable Linux virtual-console blanking and powerdown immediately. Some
# framebuffer drivers do not support every setterm power-saving operation, so
# each optional operation is deliberately best-effort.
if command -v setterm >/dev/null 2>&1; then
    setterm --blank 0 --powerdown 0 < "$tty_path" > "$tty_path" 2>/dev/null || true
    setterm --powersave off < "$tty_path" > "$tty_path" 2>/dev/null || true
fi

# Restore a fully bright, predictable console palette after the branded boot
# screen so the credential prompt cannot inherit dim or incomplete ANSI state.
printf '\033[0;97;40m\033[?25h' > "$tty_path"
