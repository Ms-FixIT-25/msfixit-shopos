#!/usr/bin/env bash
set -u

ip_address="$(hostname -I 2>/dev/null | awk '{print $1}')"
[ -n "$ip_address" ] || ip_address="unknown"

echo "Ms. FixIT ShopOS"
echo "=================="
echo "Hostname: $(hostname)"
echo "LAN IP:   $ip_address"
echo "Local URL: http://${ip_address}/"
echo

for service in nginx mariadb redis-server msfixit-cloudflared; do
    printf '%-34s %s\n' "$service" "$(systemctl is-active "$service" 2>/dev/null || true)"
done
for timer in msfixit-office-worker.timer msfixit-office-dunning.timer msfixit-office-print.timer msfixit-compliance-worker.timer; do
    if systemctl list-unit-files "$timer" --no-legend 2>/dev/null | grep -q .; then
        printf '%-34s %s\n' "$timer" "$(systemctl is-active "$timer" 2>/dev/null || true)"
    fi
done

php_service="$(systemctl list-unit-files --type=service --no-legend 'php*-fpm.service' 2>/dev/null | awk 'NR==1 {print $1}')"
if [ -n "$php_service" ]; then
    printf '%-34s %s\n' "$php_service" "$(systemctl is-active "$php_service" 2>/dev/null || true)"
fi

echo
if [ -f /etc/msfixit-shopos/catalog.env ]; then
    article_count="$(mariadb shopos_catalog --batch --skip-column-names -e 'SELECT COUNT(*) FROM catalog_products' 2>/dev/null || echo unknown)"
    next_value="$(mariadb shopos_catalog --batch --skip-column-names -e "SELECT next_value FROM catalog_sequences WHERE sequence_name='article_number'" 2>/dev/null || echo unknown)"
    pending_events="$(mariadb shopos_catalog --batch --skip-column-names -e "SELECT COUNT(*) FROM catalog_sync_outbox WHERE event_status='pending'" 2>/dev/null || echo unknown)"
    echo "Article master: initialized"
    echo "Articles:       $article_count"
    if [[ "$next_value" =~ ^[0-9]+$ ]]; then
        printf 'Next article:    MF-%08d\n' "$next_value"
    else
        echo "Next article:    $next_value"
    fi
    echo "Pending events:  $pending_events"
    echo "Sales region:    AT, DE, CH"
else
    echo "Article master: not initialized"
fi

echo
if [ -f /etc/msfixit-shopos/office.env ]; then
    echo "Office/Fulfillment: initialized"
    printf '%-28s %s\n' "Draft documents:" "$(mariadb shopos_office -Nse "SELECT COUNT(*) FROM office_documents WHERE document_status='draft'" 2>/dev/null || echo unknown)"
    printf '%-28s %s\n' "Open invoices:" "$(mariadb shopos_office -Nse "SELECT COUNT(*) FROM office_documents d WHERE d.document_type='invoice' AND d.document_status='final' AND d.gross_total > COALESCE((SELECT SUM(a.allocated_amount) FROM office_payment_allocations a WHERE a.document_id=d.id),0)" 2>/dev/null || echo unknown)"
    printf '%-28s %s\n' "Reminders to approve:" "$(mariadb shopos_office -Nse "SELECT COUNT(*) FROM office_reminders WHERE reminder_status='pending_approval'" 2>/dev/null || echo unknown)"
    printf '%-28s %s\n' "Shipments without label:" "$(mariadb shopos_office -Nse "SELECT COUNT(*) FROM office_shipments WHERE label_path IS NULL" 2>/dev/null || echo unknown)"
    printf '%-28s %s\n' "Pending print jobs:" "$(mariadb shopos_office -Nse "SELECT COUNT(*) FROM office_print_jobs WHERE print_status IN ('pending','retry')" 2>/dev/null || echo unknown)"
    printf '%-28s %s\n' "Failed Office events:" "$(mariadb shopos_office -Nse "SELECT COUNT(*) FROM office_outbox WHERE event_status='failed'" 2>/dev/null || echo unknown)"
    if [ -f /etc/msfixit-shopos/business.env ]; then
        approved="$(sed -n 's/^BUSINESS_CONFIG_APPROVED=//p' /etc/msfixit-shopos/business.env | tail -n1)"
        echo "Business config: ${approved:-unknown}"
    fi
    echo "Detailed Office status: sudo msfixit-office status"

    if mariadb shopos_office -Nse "SELECT 1 FROM compliance_market_profiles LIMIT 1" >/dev/null 2>&1; then
        echo
        echo "DACH Compliance: initialized (fail closed)"
        mariadb shopos_office --batch --skip-column-names -e \
            "SELECT CONCAT(country_code, ': B2C=', IF(b2c_enabled=1,'active','blocked'),
                           ', B2B=', IF(b2b_enabled=1,'active','blocked'),
                           ', legal=', legal_review_status,
                           ', tax=', tax_review_status)
               FROM compliance_market_profiles ORDER BY country_code" 2>/dev/null || true
        printf '%-28s %s\n' "Products awaiting review:" "$(mariadb shopos_office -Nse "SELECT COUNT(*) FROM compliance_product_markets WHERE approval_status<>'approved'" 2>/dev/null || echo unknown)"
        printf '%-28s %s\n' "Open withdrawals:" "$(mariadb shopos_office -Nse "SELECT COUNT(*) FROM compliance_withdrawals WHERE request_status NOT IN ('completed','rejected')" 2>/dev/null || echo unknown)"
        printf '%-28s %s\n' "Unapproved tax decisions:" "$(mariadb shopos_office -Nse "SELECT COUNT(*) FROM compliance_tax_decisions WHERE decision_status<>'approved'" 2>/dev/null || echo unknown)"
        echo "Detailed compliance status: sudo msfixit-compliance status"
    else
        echo "DACH Compliance: not initialized"
    fi
else
    echo "Office/Fulfillment: not initialized"
fi

echo
if [ -f /var/lib/msfixit-shopos/health.json ]; then
    jq . /var/lib/msfixit-shopos/health.json
else
    echo "Health data is not available yet."
fi

echo
for credentials in /boot/firmware/SHOPOS-CREDENTIALS.txt /boot/SHOPOS-CREDENTIALS.txt; do
    if [ -f "$credentials" ]; then
        echo "First-boot credentials: $credentials"
        echo "Delete that file after saving the credentials securely."
        break
    fi
done
