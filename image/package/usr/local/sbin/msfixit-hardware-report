#!/usr/bin/env bash
set -Eeuo pipefail

readonly output_dir=/var/log/msfixit-shopos
readonly output_file=${output_dir}/hardware-report.txt
readonly thermal_file=/sys/class/thermal/thermal_zone0/temp
readonly profile_state=/run/msfixit-shopos/performance-profile

if [ "$(id -u)" -ne 0 ]; then
    echo 'Run this command with sudo.' >&2
    exit 1
fi

install -d -m 0750 "$output_dir"

temp_c='unknown'
if [ -r "$thermal_file" ]; then
    raw_temp="$(cat "$thermal_file" 2>/dev/null || true)"
    if [[ "$raw_temp" =~ ^[0-9]+$ ]]; then
        temp_c="$(awk -v value="$raw_temp" 'BEGIN {printf "%.1f", value / 1000}')"
    fi
fi

throttled='unavailable'
arm_clock='unavailable'
if command -v vcgencmd >/dev/null 2>&1; then
    throttled="$(vcgencmd get_throttled 2>/dev/null || printf unavailable)"
    arm_clock="$(vcgencmd measure_clock arm 2>/dev/null || printf unavailable)"
fi

{
    echo 'Ms. FixIT ShopOS Raspberry Pi hardware report'
    echo '================================================'
    printf 'Generated: %s\n' "$(date --iso-8601=seconds)"
    printf 'Hostname: %s\n' "$(hostname)"
    printf 'Kernel: %s\n' "$(uname -srmo)"
    printf 'Model: %s\n' "$(tr -d '\0' </proc/device-tree/model 2>/dev/null || printf unknown)"
    printf 'Uptime and load: %s\n' "$(uptime -p 2>/dev/null || uptime) / $(cut -d ' ' -f 1-3 /proc/loadavg)"
    printf 'Temperature: %s C\n' "$temp_c"
    printf 'Firmware throttle flags: %s\n' "$throttled"
    printf 'Firmware ARM clock: %s\n' "$arm_clock"
    echo

    echo '[Applied ShopOS profile]'
    if [ -r "$profile_state" ]; then
        cat "$profile_state"
    else
        echo 'not yet recorded'
    fi
    echo

    echo '[CPU frequency policy]'
    for policy in /sys/devices/system/cpu/cpufreq/policy*; do
        [ -d "$policy" ] || continue
        printf '%s governor=%s current=%s min=%s max=%s available=%s\n' \
            "$(basename "$policy")" \
            "$(cat "$policy/scaling_governor" 2>/dev/null || printf unknown)" \
            "$(cat "$policy/scaling_cur_freq" 2>/dev/null || printf unknown)" \
            "$(cat "$policy/scaling_min_freq" 2>/dev/null || printf unknown)" \
            "$(cat "$policy/scaling_max_freq" 2>/dev/null || printf unknown)" \
            "$(cat "$policy/scaling_available_governors" 2>/dev/null || printf unknown)"
    done
    echo

    echo '[Memory and pressure]'
    free -h || true
    printf 'Swappiness: %s\n' "$(cat /proc/sys/vm/swappiness 2>/dev/null || printf unknown)"
    for pressure in cpu memory io; do
        [ -r "/proc/pressure/$pressure" ] || continue
        printf '%s: ' "$pressure"
        tr '\n' ' ' < "/proc/pressure/$pressure"
        echo
    done
    echo

    echo '[Storage]'
    lsblk -e7 -o NAME,PATH,SIZE,TYPE,TRAN,ROTA,SCHED,FSTYPE,MOUNTPOINTS 2>/dev/null || true
    echo
    echo '[Mount options]'
    for mountpoint in / /data /boot /boot/firmware; do
        findmnt -rn -o TARGET,SOURCE,FSTYPE,OPTIONS --target "$mountpoint" 2>/dev/null || true
    done
    echo
    echo '[USB topology and UASP]'
    lsusb -t 2>/dev/null || true
    echo
    echo '[TRIM support]'
    printf 'fstrim.timer enabled: %s\n' "$(systemctl is-enabled fstrim.timer 2>/dev/null || printf no)"
    printf 'fstrim.timer active: %s\n' "$(systemctl is-active fstrim.timer 2>/dev/null || printf no)"
    if findmnt -rn --target /data >/dev/null 2>&1; then
        fstrim --dry-run --verbose /data 2>&1 || true
    else
        echo '/data is not mounted.'
    fi
    echo

    echo '[ShopOS service resources]'
    service_units=(msfixit-kiosk.service mariadb.service redis-server.service nginx.service)
    while IFS= read -r php_unit; do
        [ -n "$php_unit" ] && service_units+=("$php_unit")
    done < <(systemctl list-unit-files --type=service --no-legend 'php*-fpm.service' 2>/dev/null | awk '{print $1}')
    systemctl show "${service_units[@]}" \
        --property=Id,ActiveState,SubState,CPUUsageNSec,MemoryCurrent,MemoryPeak,TasksCurrent \
        --no-pager 2>/dev/null || true
    echo
    echo '[Top processes]'
    ps -eo pid,comm,%cpu,%mem,rss,etimes --sort=-%cpu | head -n 16 || true
    echo
    echo '[Failed services]'
    systemctl --failed --no-pager || true
    echo
    echo '[Recent power, thermal and storage warnings]'
    journalctl -b --no-pager -p warning..alert \
        -g 'voltage|under.?voltage|thrott|thermal|temperature|usb|uas|reset|I/O error|ext4|nvme|sd[a-z]' \
        -n 120 2>/dev/null || true
} | tee "$output_file"

chmod 0640 "$output_file"
printf '\nSaved report: %s\n' "$output_file"
