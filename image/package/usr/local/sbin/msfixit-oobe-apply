#!/usr/bin/env python3
from __future__ import annotations
import json, os, re, sys, tempfile
from pathlib import Path

ALLOWED={"schema","locale","keyboard","timezone","network_mode","ip","gateway","dns","hostname","admin_user","password_hash","edition","apps"}
LOCALES={"de_AT","de_DE","en_GB","en_US"}; KEYBOARDS={"de","de-nodeadkeys","us","gb"}; TIMEZONES={"Europe/Vienna","Europe/Berlin","Europe/Zurich","Europe/London","UTC"}; EDITIONS={"community","professional","enterprise"}; APPS={"commerce","backup","repair","assistant","marketplaces"}

def fail(msg:str)->None:
    print(f"ERROR: {msg}",file=sys.stderr); raise SystemExit(2)

def atomic_json(path:Path,data:dict)->None:
    path.parent.mkdir(parents=True,exist_ok=True)
    fd,tmp=tempfile.mkstemp(prefix=path.name+".",dir=path.parent)
    try:
        with os.fdopen(fd,"w",encoding="utf-8") as f: json.dump(data,f,sort_keys=True,separators=(",",":")); f.write("\n"); f.flush(); os.fsync(f.fileno())
        os.chmod(tmp,0o600); os.replace(tmp,path)
    finally:
        try: os.unlink(tmp)
        except FileNotFoundError: pass

def main()->int:
    if len(sys.argv)!=2: fail("usage: msfixit-oobe-apply REQUEST_JSON")
    request=Path(sys.argv[1])
    if not request.is_file() or request.is_symlink(): fail("invalid request file")
    st=request.stat()
    if st.st_uid not in {0,33} or (st.st_mode & 0o022): fail("unsafe request ownership or mode")
    try: data=json.loads(request.read_text(encoding="utf-8"))
    except Exception: fail("invalid json")
    if not isinstance(data,dict) or set(data)!=ALLOWED or data.get("schema")!=1: fail("invalid request schema")
    if data["locale"] not in LOCALES or data["keyboard"] not in KEYBOARDS or data["timezone"] not in TIMEZONES: fail("invalid locale settings")
    if data["network_mode"] not in {"dhcp","static"}: fail("invalid network mode")
    if not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?",str(data["hostname"])): fail("invalid hostname")
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]{2,31}",str(data["admin_user"])): fail("invalid admin user")
    if not str(data["password_hash"]).startswith(("$2y$","$argon2")): fail("invalid password hash")
    if data["edition"] not in EDITIONS or not isinstance(data["apps"],list) or any(x not in APPS for x in data["apps"]): fail("invalid edition or apps")
    target=Path("/etc/msfixit-shopos/oobe.json")
    if target.exists(): fail("first-boot setup already completed")
    atomic_json(target,data)
    marker=Path("/var/lib/msfixit-shopos/oobe-complete")
    marker.parent.mkdir(parents=True,exist_ok=True); marker.write_text("complete\n",encoding="utf-8"); os.chmod(marker,0o600)
    print("ShopOS-Ersteinrichtung wurde sicher gespeichert.")
    return 0

if __name__=="__main__": raise SystemExit(main())
