#!/usr/bin/env bash
set -Eeuo pipefail

readonly profile_dir=/var/lib/msfixit-shopos/kiosk/chromium
readonly target_url=http://127.0.0.1/admin/

install -d -m 0700 "$profile_dir"

# X/KMS drivers differ in which legacy DPMS controls they expose. None of
# these cosmetic power-management calls is allowed to abort the kiosk session.
xset -dpms 2>/dev/null || true
xset s off 2>/dev/null || true
xset s noblank 2>/dev/null || true
xsetroot -solid '#0a1930' 2>/dev/null || true

local_ready=0
for _ in $(seq 1 180); do
    if curl --silent --fail --max-time 2 "$target_url" >/dev/null; then
        local_ready=1
        break
    fi
    sleep 1
done

if [ "$local_ready" -ne 1 ]; then
    printf 'ShopOS local admin endpoint did not become ready at %s; restarting kiosk session.\n' "$target_url" >&2
    exit 1
fi

exec /usr/bin/chromium \
    --kiosk \
    --app="$target_url" \
    --user-data-dir="$profile_dir" \
    --no-first-run \
    --disable-session-crashed-bubble \
    --disable-infobars \
    --disable-translate \
    --disable-background-networking \
    --disable-component-update \
    --disable-domain-reliability \
    --disable-sync \
    --disable-features=MediaRouter,OptimizationHints,AutofillServerCommunication \
    --renderer-process-limit=3 \
    --disk-cache-size=67108864 \
    --overscroll-history-navigation=0 \
    --password-store=basic
