#!/usr/bin/env bash
set -Eeuo pipefail

readonly profile_dir=/var/lib/msfixit-shopos/kiosk/chromium
readonly target_url=http://127.0.0.1/admin/

install -d -m 0700 "$profile_dir"

xset -dpms
xset s off
xset s noblank
xsetroot -solid '#0a1930'

for _ in $(seq 1 180); do
    if curl --silent --fail --max-time 2 http://127.0.0.1/ >/dev/null; then
        break
    fi
    sleep 1
done

exec /usr/bin/chromium \
    --kiosk \
    --app="$target_url" \
    --user-data-dir="$profile_dir" \
    --no-first-run \
    --disable-session-crashed-bubble \
    --disable-infobars \
    --disable-translate \
    --disable-background-networking \
    --disable-component-update \
    --disable-domain-reliability \
    --disable-sync \
    --disable-features=MediaRouter,OptimizationHints,AutofillServerCommunication \
    --renderer-process-limit=3 \
    --disk-cache-size=67108864 \
    --overscroll-history-navigation=0 \
    --password-store=basic
