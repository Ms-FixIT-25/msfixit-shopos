#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

manifest_url="${SHOPOS_UPDATE_MANIFEST_URL:-https://github.com/Ms-FixIT-25/msfixit-shopos/releases/latest/download/shopos-update-manifest.json}"
public_key="${SHOPOS_UPDATE_PUBLIC_KEY:-/usr/share/msfixit-shopos/update/update-signing-public.pem}"
updater="${SHOPOS_UPDATE_RUNTIME:-/usr/local/lib/msfixit-shopos/shopos-update.py}"
staging_root="${SHOPOS_UPDATE_STAGING_DIR:-/var/lib/msfixit-shopos/update/install-check}"
connect_timeout="${SHOPOS_UPDATE_CONNECT_TIMEOUT:-5}"
max_time="${SHOPOS_UPDATE_MAX_TIME:-30}"

log() {
    printf '[shopos-install-update] %s\n' "$*"
}

cleanup_candidate() {
    rm -rf "$staging_root/candidate" 2>/dev/null || true
}

case "$manifest_url" in
    https://*) ;;
    *)
        log 'Update manifest URL is not HTTPS; ignoring install-time update.'
        cleanup_candidate
        exit 0
        ;;
esac

if [ ! -x "$updater" ] || [ ! -f "$public_key" ] || [ -L "$public_key" ]; then
    log 'Trusted update runtime/key is unavailable; continuing with embedded image.'
    cleanup_candidate
    exit 0
fi

install -d -m 0700 "$staging_root/candidate"
manifest="$staging_root/candidate/manifest.json"
payload_json="$staging_root/candidate/payload.json"
image="$staging_root/candidate/shopos-update.img"

# Direct manifest retrieval is also the network probe. Offline/DNS/TLS/timeout
# failures are non-fatal during first installation and must leave no candidate.
if ! curl --fail --silent --show-error --location \
    --proto '=https' --tlsv1.2 \
    --connect-timeout "$connect_timeout" --max-time "$max_time" \
    --output "$manifest" "$manifest_url"; then
    log 'No usable internet/update endpoint; continuing with embedded image.'
    cleanup_candidate
    exit 0
fi

if ! python3 "$updater" --public-key "$public_key" verify "$manifest" > "$payload_json"; then
    log 'Remote update manifest failed signature/schema verification; discarding it.'
    cleanup_candidate
    exit 0
fi

readarray -t update_fields < <(python3 - "$payload_json" <<'PY'
import json, pathlib, sys
p = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding='utf-8'))
print(p['image_url'])
print(p['image_sha256'])
print(p['image_size'])
print(p['version'])
print(p['sequence'])
PY
)
image_url="${update_fields[0]:-}"
expected_sha="${update_fields[1]:-}"
expected_size="${update_fields[2]:-}"
version="${update_fields[3]:-unknown}"
sequence="${update_fields[4]:-unknown}"

case "$image_url" in
    https://*) ;;
    *)
        log 'Verified manifest contains a non-HTTPS image URL; discarding candidate.'
        cleanup_candidate
        exit 0
        ;;
esac

if ! curl --fail --silent --show-error --location \
    --proto '=https' --tlsv1.2 \
    --connect-timeout "$connect_timeout" --max-time 3600 \
    --output "$image" "$image_url"; then
    log 'Update image download failed; discarding candidate and continuing installation.'
    cleanup_candidate
    exit 0
fi

actual_size="$(stat -c '%s' "$image")"
actual_sha="$(sha256sum "$image" | awk '{print $1}')"
if [ "$actual_size" != "$expected_size" ] || [ "$actual_sha" != "$expected_sha" ]; then
    log 'Downloaded update does not match signed size/hash; discarding candidate.'
    cleanup_candidate
    exit 0
fi

if ! python3 "$updater" --public-key "$public_key" verify "$manifest" --image "$image" >/dev/null; then
    log 'Downloaded update failed final verifier check; discarding candidate.'
    cleanup_candidate
    exit 0
fi

# Do not write an OS slot during firstboot until the physical A/B writer and
# power-loss tests are production-approved. Persist only a verified candidate
# for the transactional updater to consume later.
chmod 0600 "$manifest" "$payload_json" "$image"
printf '%s\n' "$version" > "$staging_root/candidate/version"
printf '%s\n' "$sequence" > "$staging_root/candidate/sequence"
chmod 0600 "$staging_root/candidate/version" "$staging_root/candidate/sequence"
log "Verified OTA candidate $version (sequence $sequence) staged for transactional application."
exit 0
