#!/usr/bin/env bash
set -Eeuo pipefail

readonly wordpress_dir=/srv/www/wordpress
readonly cli_file=/usr/share/msfixit-shopos/wordpress/msfixit-discovery-cli.php

if [ "$(id -u)" -ne 0 ]; then
    echo "Run this command with sudo." >&2
    exit 1
fi

command_name="${1:-status}"
case "$command_name" in
    status)
        export MSFIXIT_DISCOVERY_COMMAND=status
        ;;
    audit)
        export MSFIXIT_DISCOVERY_COMMAND=audit
        export MSFIXIT_DISCOVERY_PRODUCT_ID="${2:-0}"
        if ! [[ "$MSFIXIT_DISCOVERY_PRODUCT_ID" =~ ^[0-9]+$ ]]; then
            echo "Product ID must be numeric." >&2
            exit 2
        fi
        ;;
    *)
        cat >&2 <<'EOF_USAGE'
Usage:
  sudo msfixit-discovery status
  sudo msfixit-discovery audit [WOOCOMMERCE_PRODUCT_ID]
EOF_USAGE
        exit 2
        ;;
esac

runuser -u www-data -- env \
    HOME=/tmp \
    MSFIXIT_DISCOVERY_COMMAND="$MSFIXIT_DISCOVERY_COMMAND" \
    MSFIXIT_DISCOVERY_PRODUCT_ID="${MSFIXIT_DISCOVERY_PRODUCT_ID:-0}" \
    /usr/local/bin/wp --path="$wordpress_dir" eval-file "$cli_file"
