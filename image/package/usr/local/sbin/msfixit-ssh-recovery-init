#!/usr/bin/env bash
set -Eeuo pipefail

config_dir=/etc/msfixit-shopos
admin_user_file="$config_dir/admin-user"
nft_file=/etc/nftables.d/30-shopos-ssh-recovery.nft

find_boot_file() {
    local name="$1" candidate
    for candidate in "/boot/firmware/$name" "/boot/$name"; do
        if [ -s "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

mac_file="$(find_boot_file SHOPOS-SSH-TRUSTED-MAC || true)"
key_file="$(find_boot_file SHOPOS-ADMIN.pub || true)"

# Recovery access is opt-in and fail-closed: never create a partial SSH gate.
# Both the trusted LAN MAC and a public SSH key must be present on the boot
# partition before the recovery path is activated.
if [ -z "$mac_file" ] || [ -z "$key_file" ]; then
    exit 0
fi

trusted_mac="$(tr -d '[:space:]' < "$mac_file" | tr '[:upper:]' '[:lower:]')"
if ! [[ "$trusted_mac" =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]]; then
    printf 'Invalid SHOPOS-SSH-TRUSTED-MAC; refusing to alter SSH access.\n' >&2
    exit 1
fi

public_key="$(head -n 1 "$key_file" | tr -d '\r')"
case "$public_key" in
    ssh-ed25519\ *|ssh-rsa\ *|ecdsa-sha2-nistp256\ *|ecdsa-sha2-nistp384\ *|ecdsa-sha2-nistp521\ *) ;;
    *)
        printf 'Invalid SHOPOS-ADMIN.pub; refusing to alter SSH access.\n' >&2
        exit 1
        ;;
esac

install -d -o root -g root -m 0755 /etc/nftables.d
cat > "$nft_file" <<EOF_NFT
# Generated by msfixit-ssh-recovery-init. Local-LAN recovery SSH is allowed
# only from the configured Ethernet source MAC; cryptographic authentication
# is still required by sshd.
table inet shopos_ssh_recovery {
    chain input {
        type filter hook input priority -5; policy accept;
        iifname "lo" tcp dport 22 accept
        ether saddr $trusted_mac tcp dport 22 accept
        tcp dport 22 drop
    }
}
EOF_NFT
chmod 0600 "$nft_file"

# Apply the gate immediately when nft is available. Delete our own table first
# so repeated runs are idempotent and do not disturb the rest of the firewall.
if command -v nft >/dev/null 2>&1; then
    nft delete table inet shopos_ssh_recovery 2>/dev/null || true
    nft -f "$nft_file"
fi

# The selected first-login administrator may not exist yet during the early
# boot service. The first-login wizard invokes this helper again immediately
# after creating the account, before Wi-Fi setup, so recovery still survives a
# later setup failure.
[ -r "$admin_user_file" ] || exit 0
admin_user="$(head -n 1 "$admin_user_file" | tr -d '[:space:]')"
[ -n "$admin_user" ] || exit 0
id "$admin_user" >/dev/null 2>&1 || exit 0

home_dir="$(getent passwd "$admin_user" | cut -d: -f6)"
[ -n "$home_dir" ] || exit 1
admin_group="$(id -gn "$admin_user")"

install -d -o "$admin_user" -g "$admin_group" -m 0700 "$home_dir/.ssh"
printf '%s\n' "$public_key" > "$home_dir/.ssh/authorized_keys"
chown "$admin_user:$admin_group" "$home_dir/.ssh/authorized_keys"
chmod 0600 "$home_dir/.ssh/authorized_keys"

# Ensure a valid account created during first login is not left locked. The
# SSH key remains mandatory for the recovery route; this only repairs account
# state so sshd/PAM does not reject the user before key authentication.
passwd -u "$admin_user" >/dev/null 2>&1 || true

systemctl enable ssh.service >/dev/null 2>&1 || true
systemctl try-restart ssh.service >/dev/null 2>&1 || true
exit 0
