#!/usr/bin/env bash
set -Eeuo pipefail

marker=/var/lib/msfixit-shopos/first-login-initialized
user=shopadmin

[ -e "$marker" ] && exit 0
id "$user" >/dev/null 2>&1 || { echo "Missing required user: $user" >&2; exit 1; }

install -d -o root -g root -m 0700 "$(dirname "$marker")"
chmod 0755 /usr/local/sbin/msfixit-wifi-connect 2>/dev/null || true
chmod 0644 /etc/msfixit-shopos/wifi.env 2>/dev/null || true

# Generate a console-only hexadecimal bootstrap password. It is never stored
# in the image, repository, journal or filesystem.
password="$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')"
printf '%s:%s\n' "$user" "$password" | chpasswd
chage -d 0 "$user"

{
    printf '\nMs. FixIT ShopOS first login\n'
    printf 'Username: %s\n' "$user"
    printf 'One-time password: %s\n' "$password"
    printf 'You must choose a new password immediately after login.\n'
    printf 'Wi-Fi target is preselected. After login run: sudo msfixit-wifi-connect\n\n'
} >/dev/console

# Keep only the non-secret completion marker.
touch "$marker"
chmod 0600 "$marker"
unset password
