#!/usr/bin/env bash
set -Eeuo pipefail
umask 022

readonly wordpress_dir=/srv/www/wordpress
readonly branding_dir=/usr/share/msfixit-shopos/branding
readonly generated_branding_dir=/var/lib/msfixit-shopos/branding
readonly wordpress_assets=/usr/share/msfixit-shopos/wordpress

if [ "$(id -u)" -ne 0 ]; then
    echo "Run this command with sudo." >&2
    exit 1
fi

run_wp() {
    runuser -u www-data -- env HOME=/tmp /usr/local/bin/wp --path="$wordpress_dir" "$@"
}

ensure_media() {
    local option_name="$1" source_file="$2" title="$3" alt_text="$4"
    local attachment_id

    attachment_id="$(run_wp option get "$option_name" 2>/dev/null || true)"
    if [[ "$attachment_id" =~ ^[0-9]+$ ]] \
        && run_wp post get "$attachment_id" --field=ID >/dev/null 2>&1; then
        printf '%s\n' "$attachment_id"
        return 0
    fi

    attachment_id="$(run_wp media import "$source_file" --title="$title" --porcelain)"
    run_wp post meta update "$attachment_id" _wp_attachment_image_alt "$alt_text" >/dev/null
    run_wp option update "$option_name" "$attachment_id" >/dev/null
    printf '%s\n' "$attachment_id"
}

run_wp core is-installed >/dev/null

# Storefront provides a stable WooCommerce-compatible base. ShopOS branding is
# applied through an MU plugin so the design survives normal theme updates.
if ! run_wp plugin is-installed woocommerce >/dev/null 2>&1; then
    run_wp plugin install woocommerce >/dev/null
fi
run_wp plugin activate woocommerce >/dev/null

if ! run_wp theme is-installed storefront >/dev/null 2>&1; then
    run_wp theme install storefront >/dev/null
fi
run_wp theme activate storefront >/dev/null

install -d -m 0755 "$wordpress_dir/wp-content/mu-plugins" "$generated_branding_dir"
install -m 0644 \
    "$wordpress_assets/msfixit-branding.php" \
    "$wordpress_dir/wp-content/mu-plugins/msfixit-branding.php"

php "$wordpress_assets/msfixit-render-branding.php" \
    "$branding_dir/msfixit-brand-full.webp" \
    "$generated_branding_dir"

chown -R www-data:www-data "$wordpress_dir/wp-content/mu-plugins" "$generated_branding_dir"

logo_id="$(ensure_media \
    msfixit_brand_logo_id \
    "$generated_branding_dir/msfixit-brand-header.webp" \
    'Ms. FixIT Logo' \
    'Ms. FixIT – IT-Support und Services')"

hero_id="$(ensure_media \
    msfixit_brand_hero_id \
    "$branding_dir/msfixit-brand-full.webp" \
    'Ms. FixIT Markenmotiv' \
    'Ms. FixIT – Fix. Simplify. Save.')"

icon_id="$(ensure_media \
    msfixit_brand_icon_id \
    "$generated_branding_dir/msfixit-site-icon.jpg" \
    'Ms. FixIT Einhorn' \
    'Ms. FixIT Einhorn')"

export MSFIXIT_LOGO_ID="$logo_id"
export MSFIXIT_HERO_ID="$hero_id"
export MSFIXIT_ICON_ID="$icon_id"
run_wp eval-file "$wordpress_assets/msfixit-provision.php"

run_wp cache flush >/dev/null 2>&1 || true
chown -R www-data:www-data "$wordpress_dir/wp-content"

echo "Ms. FixIT WooCommerce branding and shop structure applied successfully."
