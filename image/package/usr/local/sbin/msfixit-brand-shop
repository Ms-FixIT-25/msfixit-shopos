#!/usr/bin/env bash
set -Eeuo pipefail
umask 022

readonly wordpress_dir=/srv/www/wordpress
readonly branding_dir=/usr/share/msfixit-shopos/branding
readonly generated_branding_dir=/var/lib/msfixit-shopos/branding
readonly wordpress_assets=/usr/share/msfixit-shopos/wordpress
readonly config_dir=/etc/msfixit-shopos

if [ "$(id -u)" -ne 0 ]; then
    echo "Run this command with sudo." >&2
    exit 1
fi

run_wp() {
    runuser -u www-data -- env HOME=/tmp /usr/local/bin/wp --path="$wordpress_dir" "$@"
}

ensure_media() {
    local option_name="$1" source_file="$2" title="$3" alt_text="$4"
    local attachment_id

    attachment_id="$(run_wp option get "$option_name" 2>/dev/null || true)"
    if [[ "$attachment_id" =~ ^[0-9]+$ ]] \
        && run_wp post get "$attachment_id" --field=ID >/dev/null 2>&1; then
        printf '%s\n' "$attachment_id"
        return 0
    fi

    attachment_id="$(run_wp media import "$source_file" --title="$title" --porcelain)"
    run_wp post meta update "$attachment_id" _wp_attachment_image_alt "$alt_text" >/dev/null
    run_wp option update "$option_name" "$attachment_id" >/dev/null
    printf '%s\n' "$attachment_id"
}

run_wp core is-installed >/dev/null

# Separate application databases remain the source of truth for article identity,
# immutable commercial documents, DACH compliance and supplier staging.
/usr/local/sbin/msfixit-catalog-init
/usr/local/sbin/msfixit-office-init
/usr/local/sbin/msfixit-also-init

install -d -m 0750 "$config_dir"
if [ ! -f "$config_dir/discovery.env" ]; then
    install -m 0640 -o root -g www-data \
        /usr/share/msfixit-shopos/discovery/discovery.env.example \
        "$config_dir/discovery.env"
fi

if ! run_wp plugin is-installed woocommerce >/dev/null 2>&1; then
    run_wp plugin install woocommerce >/dev/null
fi
run_wp plugin activate woocommerce >/dev/null

if ! run_wp theme is-installed storefront >/dev/null 2>&1; then
    run_wp theme install storefront >/dev/null
fi
run_wp theme activate storefront >/dev/null

install -d -m 0755 "$wordpress_dir/wp-content/mu-plugins" "$wordpress_dir/wp-content/mu-plugins/assets" "$generated_branding_dir"
for plugin in \
    msfixit-branding.php \
    msfixit-catalog-bridge.php \
    msfixit-commerce-region.php \
    msfixit-office-bridge.php \
    msfixit-compliance.php \
    msfixit-compliance-runtime.php \
    msfixit-at-pilot.php \
    msfixit-discovery.php \
    zz-msfixit-discovery-assets.php; do
    install -m 0644 \
        "$wordpress_assets/$plugin" \
        "$wordpress_dir/wp-content/mu-plugins/$plugin"
done
install -m 0644 "$wordpress_assets/assets/msfixit-discovery.js" "$wordpress_dir/wp-content/mu-plugins/assets/msfixit-discovery.js"
install -m 0644 "$wordpress_assets/assets/msfixit-discovery.css" "$wordpress_dir/wp-content/mu-plugins/assets/msfixit-discovery.css"

php "$wordpress_assets/msfixit-render-branding.php" \
    "$branding_dir/msfixit-brand-full.webp" \
    "$generated_branding_dir"

chown -R www-data:www-data "$wordpress_dir/wp-content/mu-plugins" "$generated_branding_dir"

logo_id="$(ensure_media \
    msfixit_brand_logo_id \
    "$generated_branding_dir/msfixit-brand-header.webp" \
    'Ms. FixIT Logo' \
    'Ms. FixIT – IT-Support und Services')"

hero_id="$(ensure_media \
    msfixit_brand_hero_id \
    "$branding_dir/msfixit-brand-full.webp" \
    'Ms. FixIT Markenmotiv' \
    'Ms. FixIT – Fix. Simplify. Save.')"

icon_id="$(ensure_media \
    msfixit_brand_icon_id \
    "$generated_branding_dir/msfixit-site-icon.jpg" \
    'Ms. FixIT Einhorn' \
    'Ms. FixIT Einhorn')"

unmanaged_page_ids=()
for slug in startseite reparatur-services kontakt impressum datenschutz agb widerruf-rueckgabe vertrag-widerrufen kabel-zubehoer; do
    page_id="$(run_wp post list \
        --post_type=page \
        --name="$slug" \
        --post_status=any \
        --field=ID \
        --format=ids 2>/dev/null | awk '{print $1}')"
    if [[ "$page_id" =~ ^[0-9]+$ ]]; then
        managed="$(run_wp post meta get "$page_id" _msfixit_shopos_managed 2>/dev/null || true)"
        if [ "$managed" != "1" ]; then
            unmanaged_page_ids+=("$page_id")
        fi
    fi
done

protected_ids=""
if [ "${#unmanaged_page_ids[@]}" -gt 0 ]; then
    protected_ids="$(IFS=,; printf '%s' "${unmanaged_page_ids[*]}")"
fi
run_wp eval "update_option('msfixit_shopos_protected_page_ids', [${protected_ids}]);"

export MSFIXIT_LOGO_ID="$logo_id"
export MSFIXIT_HERO_ID="$hero_id"
export MSFIXIT_ICON_ID="$icon_id"
run_wp eval-file "$wordpress_assets/msfixit-provision.php"
run_wp eval-file "$wordpress_assets/msfixit-commerce-provision.php"
run_wp eval-file "$wordpress_assets/msfixit-discovery-provision.php"

run_wp option delete msfixit_shopos_protected_page_ids >/dev/null 2>&1 || true
for page_id in "${unmanaged_page_ids[@]}"; do
    run_wp post meta delete "$page_id" _msfixit_shopos_managed >/dev/null 2>&1 || true
done

run_wp cache flush >/dev/null 2>&1 || true
chown -R www-data:www-data "$wordpress_dir/wp-content"

echo "Ms. FixIT WooCommerce branding, AT pilot, cable discovery, ALSO staging, article master, Office/Fulfillment and compliance core applied successfully."
