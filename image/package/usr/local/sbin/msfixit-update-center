#!/usr/bin/env python3
"""Narrow privileged bridge for the authenticated ShopOS Update Center."""
from __future__ import annotations
import json, pathlib, re, subprocess, sys

AGENT='/usr/local/sbin/msfixit-update-agent'
APP_HELPER='/usr/local/sbin/msfixit-app-install-helper'
UPDATE='/usr/local/sbin/msfixit-update'
STATE=pathlib.Path('/var/lib/msfixit-shopos/update/state.json')
APPS=pathlib.Path('/var/lib/msfixit-shopos/apps')
INBOX=pathlib.Path('/var/lib/msfixit-shopos/app-inbox')
APP_RE=re.compile(r'^at\.msfixit\.shopos\.[a-z0-9]+(?:[.-][a-z0-9]+)*$')
UNIT='msfixit-update-manual.service'

class CenterError(RuntimeError): pass

def run(args:list[str], timeout:int=60)->str:
 r=subprocess.run(args,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,check=False,timeout=timeout)
 if r.returncode: raise CenterError(r.stderr.strip() or r.stdout.strip() or 'Aktion fehlgeschlagen')
 return r.stdout.strip()

def system_state()->dict:
 try: state=json.loads(run([UPDATE,'--state',str(STATE),'status']))
 except Exception: state={'state':'unknown','active_slot':'unknown','installed_sequence':0}
 active=run(['systemctl','show',UNIT,'--property=ActiveState','--value']).strip() or 'inactive'
 result=run(['systemctl','show',UNIT,'--property=Result','--value']).strip() or 'unknown'
 return {'transaction':state,'job':{'active_state':active,'result':result},'reboot_required':state.get('state')=='trial'}

def apps()->list[dict]:
 ids=set()
 if APPS.is_dir(): ids.update(p.name for p in APPS.iterdir() if p.is_dir() and APP_RE.fullmatch(p.name))
 if INBOX.is_dir(): ids.update(p.name[:-7] for p in INBOX.glob('*.shopos') if APP_RE.fullmatch(p.name[:-7]))
 out=[]
 for app_id in sorted(ids):
  manifest=APPS/app_id/'.shopos-manifest.json'; version='installiert'
  if manifest.is_file() and not manifest.is_symlink():
   try: version=str(json.loads(manifest.read_text()).get('version') or version)
   except Exception: pass
  out.append({'id':app_id,'installed':(APPS/app_id).is_dir(),'installed_version':version,'update_package_ready':(INBOX/f'{app_id}.shopos').is_file()})
 return out

def main()->int:
 try:
  command=sys.argv[1] if len(sys.argv)>1 else ''
  if command=='status': print(json.dumps({'system':system_state(),'apps':apps()},sort_keys=True)); return 0
  if command=='check-system': print(run([AGENT,'check'],120)); return 0
  if command=='start-system-update':
   if system_state()['job']['active_state'] in {'activating','active','reloading'}: raise CenterError('Ein Systemupdate läuft bereits.')
   run(['systemd-run','--unit='+UNIT,'--collect','--property=Type=exec',AGENT,'apply','--no-reboot'])
   print(json.dumps({'started':True})); return 0
  if command=='reboot': run(['systemctl','reboot']); return 0
  if command=='update-app':
   if len(sys.argv)!=3 or not APP_RE.fullmatch(sys.argv[2]): raise CenterError('Ungültige App-ID.')
   print(run([APP_HELPER,'install',sys.argv[2]],600)); return 0
  if command=='update-all-apps':
   ready=[a['id'] for a in apps() if a['update_package_ready']]
   results=[]
   for app_id in ready: results.append({'id':app_id,'result':run([APP_HELPER,'install',app_id],600)})
   print(json.dumps({'updated':results},sort_keys=True)); return 0
  raise CenterError('Nicht erlaubte Update-Center-Aktion.')
 except (CenterError,OSError,subprocess.SubprocessError,json.JSONDecodeError) as exc:
  print(f'ERROR: {exc}',file=sys.stderr); return 1
if __name__=='__main__': raise SystemExit(main())
